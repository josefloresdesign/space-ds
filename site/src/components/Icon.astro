---
import icons from '../icons.json';
interface Props { name: keyof typeof icons; size?: number; class?: string; label?: string }
const { name, size = 16, class: cls = '', label } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"
  class={`shrink-0 ${cls}`} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}
  set:html={icons[name]}
/>
